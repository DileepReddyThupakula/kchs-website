# Required at runtime for admissions persistence. Use Vercel's pooled Postgres
# connection variable; it must be server-only and never committed.
POSTGRES_URL=

# Required for Supabase Auth in the browser and server-rendered staff portal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional notification after a successfully persisted enquiry. It must never be
# the source of truth for admissions storage.
ADMISSIONS_WEBHOOK_URL=
